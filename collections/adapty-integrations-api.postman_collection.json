          "request": {
            "name": "Add integration identifiers",
            "description": {
              "content": "Attach third-party integration identifiers (e.g. AppsFlyer, Amplitude, Adjust, OneSignal) to an Adapty profile so subscription events can be reconciled across the customer's analytics and attribution stack.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profile",
                "integration-identifiers",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "The user's Adapty profile ID.",
                "key": "adapty-profile-id",
                "value": "<uuid>"
              },
              {
                "disabled": false,
                "description": "The user's ID in your own system.",
                "key": "adapty-customer-user-id",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
